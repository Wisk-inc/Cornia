# Copy to .env.local and fill in. .env.local is gitignored.

# --- Clerk (app sign-in) -----------------------------------------------------
# From https://dashboard.clerk.com → API keys. Without these the app skips the
# Clerk gate entirely and goes straight to the ChatGPT sign-in screen.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Billing (optional) ------------------------------------------------------
# Cornia Max is sold through Clerk Billing. The checkout button needs the plan's
# `cplan_…` id; `has({ plan })` matches on its slug — set whichever differs from
# the defaults in app/lib/plans.ts and app/lib/entitlements.ts.
# NEXT_PUBLIC_CORNIA_MAX_PLAN_ID=cplan_xxx
# NEXT_PUBLIC_CORNIA_MAX_PLAN_SLUG=cornia_max

# Where usage counters and background jobs are written. Defaults to
# .cornia-usage/ and .cornia-jobs/ next to the app.
# CORNIA_USAGE_ROOT=
# CORNIA_JOB_ROOT=

# --- Cornia Code / GitHub (optional) -----------------------------------------
# Two ways to connect, in order of preference.
#
# 1. As the GitHub App. GITHUB_APP_PRIVATE_KEY is the *contents of the PEM file*
#    downloaded from the app's settings page — the "SHA256:…" string shown next
#    to it is only a fingerprint and cannot sign anything. Either paste the PEM
#    with literal \n between lines, or point at the file another way.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALLATION_ID=      # optional; the first installation is used otherwise
# GITHUB_APP_SLUG=cornia-ai        # only changes the "install the app" link
#
# 2. A token. A personal access token with `repo` scope, or an installation
#    token minted elsewhere. Quicker to set up, acts as you rather than the app.
# GITHUB_TOKEN=

# --- Image generation (optional) ---------------------------------------------
# Used only when the signed-in ChatGPT account is not allowed to generate
# images (the "Forbidden" case). A plain OpenAI API key covers it instead.
# OPENAI_API_KEY=sk-proj-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Web search (optional) ---------------------------------------------------
# Without any of these, search falls back to DuckDuckGo, which needs no key but
# rate-limits hard. Set one for reliable research.
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=

# --- Sandbox (optional) ------------------------------------------------------
# Wraps every terminal command, e.g. to run it inside a container:
#   AGENT_SANDBOX_COMMAND="docker run --rm -i -v $PWD:/work -w /work node:22 bash -lc"
# AGENT_SANDBOX_COMMAND=

# Pin the Codex client version the model catalog is requested for.
# CODEX_CLIENT_VERSION=
